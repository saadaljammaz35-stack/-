{
  "name": "mubayn",
  "version": "0.1.0",
  "private": true,
  "description": "MUBAYN — evidence-based AI inspection reports for used devices.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
