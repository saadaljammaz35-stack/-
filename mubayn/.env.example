# MUBAYN — environment template. Copy to .env.local for development.
# In production set these in the hosting provider's encrypted env settings.
# NEVER commit real values.

NODE_ENV=development
APP_URL=http://localhost:3100

# PostgreSQL (production: managed Postgres with TLS, e.g. Neon / AWS RDS)
DATABASE_URL=postgresql://mubayn:mubayn_local_dev@localhost:5432/mubayn_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=

# Storage: "local" for development only. Production: "s3" (AWS S3, Cloudflare R2, ...)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# E-mail: "console" for development only. Production: "resend", or "none" for
# no e-mail at all (accounts work at once and reset passwords with one-time
# recovery codes; reports are only shown on the site).
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=MUBAYN <no-reply@your-domain>

# AI (Anthropic). Without a key, analyses fail honestly and no report is produced.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=high

# Scheduler secret: the cron job calls GET /api/cron/jobs with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Set to true only behind a proxy that overwrites X-Forwarded-For (e.g. Vercel)
TRUST_PROXY=false

# Local Chromium for PDF rendering in development (production uses @sparticuz/chromium)
CHROMIUM_EXECUTABLE_PATH=

# Business identity shown on legal pages. Leave empty until it is real.
BUSINESS_LEGAL_NAME=
BUSINESS_CR_NUMBER=
BUSINESS_ADDRESS=
BUSINESS_COUNTRY=SA
SUPPORT_EMAIL=
