# Edge Function secrets — set in production with:
#   supabase secrets set --env-file supabase/functions/.env
# NEVER commit the real file. SUPABASE_URL / SERVICE_ROLE_KEY are injected automatically.

# Claude API key for item recognition, room scans and dialect fallback
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-opus-5-5)
MAHALLAK_AI_MODEL=

# Background removal provider: photoroom | removebg
BG_REMOVAL_PROVIDER=photoroom
BG_REMOVAL_API_KEY=

# RevenueCat: secret REST key (entitlement checks) + webhook Authorization header value
REVENUECAT_SECRET_KEY=sk_...
REVENUECAT_WEBHOOK_AUTH=Bearer change-me-long-random-string
