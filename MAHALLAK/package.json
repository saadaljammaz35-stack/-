    "@react-native-google-signin/google-signin": "^17.0.0",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.119.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "i18next": "^27.1.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.2",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^11.0.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3",
    "undici": "^7.30.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --json --outputFile=reports/jest-results.json --testPathIgnorePatterns=/node_modules/ /supabase/ /tools/ /integration/",
    "dialect:eval": "jest src/features/dialect/__tests__/dialect-eval.test.ts --runInBand",
    "report:tests": "node scripts/build-test-report.mjs",
    "export:web": "expo export --platform web",
    "doctor": "npx expo-doctor",
    "test:integration": "MAHALLAK_IT=1 jest src/__tests__/integration --json --outputFile=reports/integration-results.json",
    "supabase:harness": "deno run -A --config supabase/functions/deno.json supabase/tests/functions-harness.ts",
    "cost:model": "node scripts/cost-model.mjs",
    "brand:generate": "cd tools/brand && npm install && node generate.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/",
      "/tools/"
    ],
    "setupFiles": [
      "./jest.setup.ts"
    ]
  }
}
