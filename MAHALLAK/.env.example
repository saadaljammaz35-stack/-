# ───────────────────────────────────────────────────────────────────────────
# MAHALLAK — app configuration (copy to .env.local for local development).
# Only PUBLIC values go here. They are embedded in the app bundle by design.
# NEVER put secret keys (AI provider, Supabase service role, RevenueCat secret,
# background-removal provider) in this file: they belong in Supabase Edge
# Function secrets — see supabase/functions/.env.example.
# For EAS builds, set these with `eas env:create` per environment instead.
# ───────────────────────────────────────────────────────────────────────────

# Supabase project (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Sign-In (Google Cloud Console → Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Reversed iOS client id, enables the native config plugin at build time
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxxxxx

# RevenueCat public SDK keys (Project → API keys → App-specific keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx

# Public legal pages
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms

# Build-time only (not embedded): EAS project + owner, set after `eas init`
EAS_PROJECT_ID=
EXPO_OWNER=
