# SAMAT | سماط — environment variables. Copy to .env.local and fill in. Never commit real values.

# --- Site -------------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner account ------------------------------------------------------------------------------
# Whoever signs in with one of these e-mails (verified by an e-mail OTP) becomes an Owner. Comma separated.
SUPER_ADMIN_EMAIL=

# --- Payments: Moyasar (https://dashboard.moyasar.com → Settings → API keys) ---------------------
# moyasar | simulator   (simulator is refused when NODE_ENV=production)
PAYMENT_PROVIDER=moyasar
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# The secret token you set on the webhook in the Moyasar dashboard.
MOYASAR_WEBHOOK_SECRET=
# Apple Pay: label shown on the payment sheet (domain must be registered with Moyasar first).
MOYASAR_APPLE_PAY_LABEL=SAMAT

# --- E-mail (transactional) ------------------------------------------------------------------------
# resend | smtp | none
EMAIL_PROVIDER=resend
EMAIL_FROM="SAMAT <orders@your-domain.sa>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- SMS (customer OTP + order updates) --------------------------------------------------------
# unifonic | taqnyat | twilio | none
SMS_PROVIDER=none
SMS_SENDER_NAME=SAMAT
UNIFONIC_APP_SID=
TAQNYAT_BEARER_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Twilio Verify for customer sign-in codes (no commercial registration / sender name needed):
# Twilio Console → Verify → Services → create one, copy its SID (VA…). Uses TWILIO_ACCOUNT_SID/TOKEN above.
TWILIO_VERIFY_SERVICE_SID=
# Optional: an API key (SK…) + secret instead of the auth token above (recommended).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Secret shared with Supabase Auth's "Send SMS" hook (format: v1,whsec_...)
SEND_SMS_HOOK_SECRETS=

# --- Customer sign-in ----------------------------------------------------------------------------
# Google: OAuth client ID (Google Cloud → Google Auth Platform → Clients → Web; JS origin = your site). Public value.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 'off' hides SMS sign-in (e.g. while the SMS account is a trial).
CUSTOMER_PHONE_LOGIN=

# --- WhatsApp Business (Meta Cloud API) --------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Approved template names (each template takes the order number as {{1}})
WHATSAPP_TEMPLATE_LANG_AR=ar
WHATSAPP_TEMPLATE_LANG_EN=en

# --- SAMAT AI (Anthropic Claude API) ------------------------------------------------------------
ANTHROPIC_API_KEY=
SAMAT_AI_MODEL=claude-opus-5-5

# --- Scheduled jobs -------------------------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# --- Printing (optional LAN print bridge) --------------------------------------------------------
PRINT_BRIDGE_TOKEN=
