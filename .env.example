# NABD — environment template
#
# Copy to .env and fill in. NEVER commit .env.
# Production uses a secret manager; these names are the contract between the
# application and whatever supplies the values.

NODE_ENV=development
PORT=3000
API_PREFIX=v1

# ── database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nabd:nabd@localhost:5432/nabd_dev
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ── redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── authentication ──────────────────────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -base64 48
# Production refuses to start if this contains a development marker.
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ISSUER=nabd
JWT_AUDIENCE=nabd-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── encryption ──────────────────────────────────────────────────────────────
# Envelope key for PII columns. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-at-least-32-random-characters

# ── security ────────────────────────────────────────────────────────────────
# Explicit origins only. A wildcard is rejected in production.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Only as many hops as you actually run behind — trusting more lets a client
# spoof X-Forwarded-For and evade per-IP rate limits.
TRUST_PROXY_HOPS=1

# ── providers ───────────────────────────────────────────────────────────────
# "mock" is refused in production. Real credentials come from the secret
# manager and never from this file outside development.
PAYMENT_PROVIDER=mock
BANKING_PROVIDER=mock
CARD_PROVIDER=mock
KYC_PROVIDER=mock
SANCTIONS_PROVIDER=mock

PAYMENT_WEBHOOK_SECRET=development-only-webhook-secret
CARD_WEBHOOK_SECRET=development-only-webhook-secret

# ── features ────────────────────────────────────────────────────────────────
# Both are refused in production.
ENABLE_SEED_DATA=true
ENABLE_SWAGGER=true

# ── object storage ──────────────────────────────────────────────────────────
STORAGE_BUCKET=nabd-documents-dev
STORAGE_REGION=me-south-1
