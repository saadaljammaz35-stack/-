{
  "name": "LunarSweep",
  "tree": {
    "$className": "DataModel",

    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "src/ReplicatedFirst"
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$properties": {
        "LoadStringEnabled": false
      },
      "$attributes": {
        "RunSelfTests": true,
        "AdminUserIds": ""
      },
      "Main": {
        "$path": "src/ServerScriptService/Main.server.luau"
      },
      "Services": {
        "$path": "src/ServerScriptService/Services"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CameraMaxZoomDistance": 90,
        "CameraMinZoomDistance": 6,
        "CharacterJumpPower": 42,
        "CharacterUseJumpPower": true,
        "CharacterWalkSpeed": 18,
        "AutoJumpEnabled": true,
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/StarterPlayerScripts/Client.client.luau"
        },
        "Controllers": {
          "$path": "src/StarterPlayerScripts/Controllers"
        },
        "UI": {
          "$path": "src/StarterPlayerScripts/UI"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts"
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false,
        "ShowDevelopmentGui": true
      }
    },

    "StarterPack": {
      "$className": "StarterPack"
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 3
      }
    },

    "Workspace": {
