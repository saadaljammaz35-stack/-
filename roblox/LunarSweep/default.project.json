      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [18, 1.2, 18],
          "Position": [0, 1.1, 0],
          "Material": "Neon",
          "Color": [1, 0.48, 0.1],
          "Transparency": 0.15,
          "Duration": 0,
          "Neutral": true,
          "CanCollide": true
        }
      },
      "SafetyFloor": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [600, 2, 600],
          "Position": [0, -1.6, 0],
          "Material": "Concrete",
          "Color": [0.62, 0.64, 0.68],
          "Transparency": 1,
          "CanCollide": true,
          "CastShadow": false
        }
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "Ambient": [0.27, 0.28, 0.33],
        "OutdoorAmbient": [0.52, 0.54, 0.62],
        "Brightness": 2.6,
        "ClockTime": 14.2,
        "GeographicLatitude": 23,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.8,
        "GlobalShadows": true,
        "ShadowSoftness": 0.15,
        "ExposureCompensation": 0.1,
        "FogEnd": 100000,
        "FogColor": [0.02, 0.02, 0.04]
