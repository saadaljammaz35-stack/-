-- The nine cleanable zones (plus the colony hub). Each zone has its own terrain style,
-- dust type, debris table, unlock requirements, lighting mood and secrets.

export type DebrisEntry = { Id: string, Weight: number }

export type ZoneDef = {
	Id: string,
	Index: number,
	Name: string,
	Subtitle: string,
	Grid: { number }?,
	Level: number,
	Cost: number,
	DirtyMaterial: Enum.Material,
	CleanMaterial: Enum.Material,
	RockMaterial: Enum.Material,
	DirtyColor: Color3,
	CleanColor: Color3,
	RockColor: Color3,
	Accent: Color3,
	DustResource: string,
	DustPerCell: number,
	XpPerCell: number,
	Debris: { DebrisEntry },
	PickupCount: number,
	RegrowSeconds: number,
	Terrain: {
		Base: number,
		Amp: number,
		Scale: number,
		Craters: number,
		CraterR: { number },
		CraterD: { number },
	},
	Lighting: {
		Brightness: number,
		Ambient: Color3,
		OutdoorAmbient: Color3,
		Exposure: number,
		ColorTint: Color3,
		Dark: boolean,
	},
	Music: string,
	SpawnXZ: { number },
	Description: string,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

