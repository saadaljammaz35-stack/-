{
  "name": "nabd",
  "version": "0.1.0",
  "private": true,
  "description": "NABD — FinTech platform. Not a licensed bank.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --pretty",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo apps/*/dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "test": "npm run build && node --test \"packages/*/dist/**/*.test.js\"",
    "test:ledger": "npm run build && node --test packages/ledger/dist/**/*.test.js",
    "db:up": "bash tools/db/up.sh",
    "db:migrate": "bash tools/db/migrate.sh",
    "db:verify": "bash tools/db/verify.sh",
    "db:seed": "bash tools/db/seed.sh",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run db:verify"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.46.0"
  }
}
