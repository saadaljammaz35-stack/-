# ─── الموقع ───────────────────────────────────────────────────────────────
# الرابط العام للموقع (الروابط الأساسية، RSS، الخريطة، روابط البريد). بدون شرطة في النهاية.
NEXT_PUBLIC_SITE_URL=https://wared.example

# ─── Supabase ────────────────────────────────────────────────────────────
# Project Settings → API. المفتاح العام (publishable) آمن للمتصفح.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# المفتاح السري: للخادم فقط. لا تضع أمامه NEXT_PUBLIC_ أبدًا.
# يُستخدم لرفع الملفات، والنماذج العامة، والدعوات، والإحصائيات، وتحديد معدل الطلبات.
SUPABASE_SECRET_KEY=
# المشاريع القديمة: تُقبل الأسماء التالية بدلًا من السابقة.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ─── الأمان ──────────────────────────────────────────────────────────────
# 32 حرفًا عشوائيًا على الأقل: openssl rand -base64 48
# يوقّع رموز النماذج ويجزّئ عناوين IP. بدونه تتوقف النماذج في الإنتاج وتعرض «غير متاح».
APP_SECRET=

# ─── البريد (Resend) ─────────────────────────────────────────────────────
# اختياري. بدونه تُحفظ الاشتراكات «بانتظار التأكيد» ولا تُرسل تنبيهات.
RESEND_API_KEY=
EMAIL_FROM="وارد <newsletter@wared.example>"
# بريد الفريق لتنبيهات رسائل التواصل وطلبات الرعاية والانضمام.
INBOX_NOTIFY_EMAIL=

# ─── وضع العرض ───────────────────────────────────────────────────────────
# 1 = محتوى تجريبي معلَّم بشريط واضح لمعاينة التصميم بدون قاعدة بيانات. لا تفعّله في الإنتاج.
NEXT_PUBLIC_DEMO_CONTENT=0
