# ─────────────────────────────────────────────────────────────
# MEDAD website — environment configuration
# Copy to `.env.local` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public, absolute URL of the deployed site (used for canonical URLs,
# Open Graph, sitemap). On Vercel, the production URL is detected
# automatically when this is left empty.
NEXT_PUBLIC_SITE_URL=

# ── Contact form delivery ───────────────────────────────────
# The form is only reported as sent when one of the options below
# accepts the message. With neither configured, the API answers
# 503 "not_configured" and the form says so honestly.

# Option A — any HTTPS webhook that accepts a JSON POST
# (Formspree, Make, Zapier, n8n, Slack workflow, your own backend…)
CONTACT_WEBHOOK_URL=

# Option B — email through Resend (https://resend.com)
RESEND_API_KEY=
# Inbox that receives project enquiries
CONTACT_TO_EMAIL=
# Sender. Leave empty to use Resend's test sender (onboarding@resend.dev),
# which can only deliver to the email that owns the Resend account.
# After verifying your domain in Resend, use e.g. "MEDAD <hello@your-domain.com>".
CONTACT_FROM_EMAIL=
