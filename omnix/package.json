{
  "name": "omnix",
  "version": "1.0.0",
  "private": true,
  "description": "OMNIX — platform with a private, customizable, continuously improvable personal AI model.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.mts up",
    "db:rollback": "node scripts/migrate.mts down",
    "db:seed": "node scripts/seed.mts",
    "models:fetch": "node scripts/fetch-models.mts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "node e2e/run.mts",
    "test:worker": "cd worker && python -m pytest -q",
    "worker": "cd worker && python -m omnix_trainer.worker",
    "verify": "npm run typecheck && npm run lint && npm run test:all && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "geist": "1.9.2",
    "mammoth": "1.13.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
