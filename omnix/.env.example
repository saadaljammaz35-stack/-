# OMNIX Personal AI — configuration. Copy to .env.local (development) or set
# in your platform's secret manager (production). Never commit real values.

# ---- Database (PostgreSQL 16 + pgvector) ----
# App role: member of omnix_app, NOT superuser, NOT BYPASSRLS (RLS must apply).
DATABASE_URL=postgres://omnix_app_login:CHANGE_ME@localhost:5432/omnix_dev
# Owner role, used only by `npm run db:migrate`.
MIGRATION_DATABASE_URL=postgres://omnix_owner:CHANGE_ME@localhost:5432/omnix_dev
# Python trainer role (member of omnix_worker).
WORKER_DATABASE_URL=postgres://omnix_worker_login:CHANGE_ME@localhost:5432/omnix_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- Security ----
# 32 random bytes, base64: `openssl rand -base64 32`. Seals provider API keys.
OMNIX_SECRETS_KEY=
# Public https origin in production (CSRF origin check, production safety).
OMNIX_PUBLIC_ORIGIN=
OMNIX_SESSION_TTL_HOURS=168
# false = no new accounts (set it after the owner has registered on a private server).
OMNIX_REGISTRATION_OPEN=true
# Only behind a reverse proxy you control (rate limits read X-Forwarded-For).
OMNIX_TRUST_PROXY=false

# ---- Storage ----
OMNIX_STORAGE_DIR=.storage
OMNIX_MAX_UPLOAD_MB=25
# Background jobs inline after the response (dev). Production: false + `npm run ai-worker`.
OMNIX_INLINE_JOBS=true

# ---- Model providers (server-side only; never exposed to browsers) ----
# Production: vLLM on a private network. Key in OMNIX_PROVIDER_SECRET_VLLM.
VLLM_URL=
OMNIX_PROVIDER_SECRET_VLLM=
# Development: Ollama.
OLLAMA_URL=
# Any OpenAI-compatible endpoint.
OPENAI_COMPAT_URL=
OPENAI_COMPAT_NAME=openai-compatible
OMNIX_PROVIDER_SECRET_OPENAI_COMPATIBLE=
# Hugging Face Inference router (enabled when the token is set).
HF_INFERENCE_URL=https://router.huggingface.co/v1
OMNIX_PROVIDER_SECRET_HUGGINGFACE=
# In-process ONNX model for development/CI (no server needed). Off in production by default.
OMNIX_LOCAL_ONNX_ENABLED=true
OMNIX_LOCAL_ONNX_MODEL=onnx-community/Qwen2.5-0.5B-Instruct
OMNIX_LOCAL_ONNX_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
OMNIX_LOCAL_ONNX_DTYPE=q8
OMNIX_MODELS_DIR=.models
OMNIX_ALLOW_MODEL_DOWNLOAD=true

# Default base model recorded for new personal models (when vLLM/Ollama is configured).
OMNIX_DEFAULT_PROVIDER=
OMNIX_DEFAULT_BASE_MODEL=Qwen/Qwen3-8B
OMNIX_DEFAULT_PROVIDER_MODEL=

# ---- Embeddings ----
# local_onnx | ollama | openai_compatible | none ; model must have an index (see AI_MODEL_DATABASE.md §4)
# none = keyword search only (serverless hosting without a model server).
EMBEDDING_PROVIDER=local_onnx
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_URL=
OMNIX_PROVIDER_SECRET_EMBEDDINGS=

# ---- Tools ----
OMNIX_ENABLE_FETCH_TOOL=false

# ---- Training worker (Python) ----
OMNIX_ARTIFACTS_DIR=artifacts
OMNIX_WORKER_ID=
HF_TOKEN=

# ---- Development seed ----
OMNIX_SEED_EMAIL=demo@omnix.local
OMNIX_SEED_MODEL_NAME=My AI

OMNIX_LOG_LEVEL=info
