# ─────────────────────────────────────────────────────────────
# لَبِنة · Labina Studio — environment variables
# انسخ هذا الملف إلى .env.local واملأ القيم.
# ─────────────────────────────────────────────────────────────

# رابط الموقع النهائي (يُستخدم في روابط إدارة الحجز والرسائل وخريطة الموقع)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# المفتاح العام (publishable / anon). آمن للواجهة لأن RLS يحمي البيانات.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الخدمة السري — لا يُستخدم في الموقع إطلاقاً، فقط لسكربت إنشاء المسؤول:
#   npm run admin:create -- email@example.com "StrongPassword" "الاسم"
# لا تضعه في Vercel ولا تشاركه.
SUPABASE_SERVICE_ROLE_KEY=

# ── الإشعارات بالبريد (اختياري) ─────────────────────────────
# عند تعبئة القيمتين تُرسل رسائل تأكيد الحجز للعميل وتنبيه للاستوديو عبر Resend.
RESEND_API_KEY=
# مثال: "لَبِنة <bookings@your-domain.com>" — يجب أن يكون النطاق موثقاً في Resend
NOTIFY_FROM_EMAIL=
