{
  "name": "ward",
  "version": "1.0.0",
  "private": true,
  "description": "WARD | وارد — public site and WARD OS, the AI media operating system.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "founder:create": "tsx scripts/create-founder.ts",
    "worker": "tsx scripts/worker.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "command": "tsx scripts/run-command.ts",
    "fonts:build": "python3 tools/ward-type/build.py --out public/fonts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.6",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
