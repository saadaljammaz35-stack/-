# ───────────── WARD / WARD OS — environment ─────────────
# Copy to .env.local (local) or set in your host's dashboard (production).
# Every API key is read on the server only. None of them is ever stored in the database
# or sent to the browser.

# Database. Leave DATABASE_URL empty to use the embedded local Postgres (PGlite) in
# PGLITE_DATA_DIR — migrations and seed run automatically on first start.
# Supabase: use the pooled connection string (Transaction mode, port 6543).
DATABASE_URL=
DB_POOL_MAX=5
PGLITE_DATA_DIR=.data/pglite

WARD_ORG_SLUG=ward
# Public site URL, used by WARD Tech's read-only health check.
WARD_SITE_URL=

# Background jobs: "true" processes queued jobs right after each request (single server,
# local dev). Keep a worker (`npm run worker`) or the cron endpoint as the durable path.
WARD_INLINE_JOBS=true
# Required for /api/cron (Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"). 24+ chars.
CRON_SECRET=

# Founder account created by `npm run db:seed` / `npm run founder:create`.
WARD_FOUNDER_EMAIL=
WARD_FOUNDER_PASSWORD=
WARD_FOUNDER_NAME=المؤسس

# ───────────── AI providers (configure at least one) ─────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Local models, e.g. http://localhost:11434 (only where an Ollama server is reachable).
OLLAMA_BASE_URL=
# Optional overrides (proxies / compatible gateways).
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ───────────── Outbound email (optional) ─────────────
# Without these, an approved "send message" is marked as manual — nothing is sent.
RESEND_API_KEY=
WARD_EMAIL_FROM=
